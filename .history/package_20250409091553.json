{
  "name": "xslt-software",
  "version": "1.0.0",
  "description": "PPTX to HTML converter using XSLT",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss src/styles/main.css -o public/styles/main.css",
    "build:js": "esbuild src/js/main.js --bundle --minify --outfile=public/js/main.js",
    "dev": "netlify dev"
  },
  "dependencies": {
    "@netlify/functions": "^2.0.0",
    "jszip": "^3.10.1",
    "mime-types": "^2.1.35",
    "node-fetch": "^3.3.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "esbuild": "^0.19.5",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.3.5"
  }
}

